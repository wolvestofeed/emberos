# Public site address, used for canonical URLs and Open Graph images.
NEXT_PUBLIC_SITE_URL=https://foodismymuse.com
# App sign-in addresses. Defaults live in src/config/apps.ts; set these only to override.
# NEXT_PUBLIC_MUSE_URL=https://muse.foodismymuse.com
# NEXT_PUBLIC_COTYLEDON_URL=https://cotyledon.foodismymuse.com/farm/dashboard
# Consulting site contact. Book a call links here; with no booking URL it links to the email, and
# with neither it points at the contact block on /about and the footer shows [email].
# NEXT_PUBLIC_CONTACT_EMAIL=
# NEXT_PUBLIC_BOOKING_URL=
